# Copy this file to .env.local (never commit .env.local) and fill in the blanks.

# --- Supabase (public values, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# --- Cloudinary (server-only: NEVER prefix these with NEXT_PUBLIC_) ---
# Cloud name: copy it from the Cloudinary dashboard ("Cloud name"). It is intentionally left blank
# because "uwr3jend" has not been confirmed as the cloud name yet.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=your-cloudinary-api-key
# Set the secret locally / on your host only. Rotate the secret that was shared in chat first.
CLOUDINARY_API_SECRET=

# --- Inquiry email (optional, server-only) ---
# FormSubmit can issue a random alias for your address after activation, so the address never appears
# anywhere public. If you have one, set the full endpoint here (https://formsubmit.co/ajax/<alias>).
FORMSUBMIT_ENDPOINT=
# Set to "off" to stop the browser from trying FormSubmit directly if the server cannot reach it.
INQUIRY_BROWSER_FALLBACK=

# --- Customer CRM (/admin/dashboard) ---
# SERVER-ONLY. Lets the website's inquiry API save public form submissions into public.crm_inquiries.
# Supabase Dashboard -> Project Settings -> API Keys -> "service_role" / secret key.
# NEVER prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=
# Production origin of the site (default: https://thepopsybar.com).
NEXT_PUBLIC_SITE_URL=https://thepopsybar.com
# Time zone that decides what "today" means for event dates (default: America/Chicago, Rosenberg TX).
NEXT_PUBLIC_BUSINESS_TIME_ZONE=America/Chicago

# --- Web Push notifications for new website inquiries (no third-party service) ---
# Generate once with:  npm run vapid:generate   (prints a key pair; nothing is saved to disk)
# The PUBLIC key is safe for the browser. The PRIVATE key is a secret: server-only, never commit it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: "mailto:you@example.com" (or an https URL). Defaults to the site URL.
VAPID_SUBJECT=
# Protects /api/push/retry (the retry job). Any long random string, e.g.  openssl rand -hex 32
# Vercel Cron sends it automatically as "Authorization: Bearer <value>".
CRON_SECRET=
